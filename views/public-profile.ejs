<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
</head>
  <body class = "d-flex align-item-center py-4">
    <main class = "container text-center">
    <div class="profile-card mx-auto p-3">
      <img src="https://static.promediateknologi.id/crop/0x0:0x0/0x0/webp/photo/p2/75/2025/04/24/Gambar-WhatsApp-2025-04-24-pukul-174500_0b47cd5d-3206504896.jpg" 
      class="profile-pic rounded-circle mb-3 shadow"/>

      <h1 class="username h2" style="font-size:  50px; color: brown;"><%= username %> </h1>
      <p class="bio mb-4 px-3" style="font-size: 20px; color: brown;"><%= bio %> </p>

      <div class="bold d-grid gap-3">
        <a href="/" class="btn btn-glass btn-lg" style="font-weight: 700; color: brown;">Youtube</a>
        <a href="/" class="btn btn-glass btn-lg" style="font-weight: 700; color: brown;">Instagram</a>
        <a href="/" class="btn btn-glass btn-lg" style="font-weight: 700; color: brown;">X</a>
      </div>
      
    <div class="social-icons mt-5">
      <a href="/" class="mx-3"><i class="bi bi-whatsapp"></i></a>
      <a href="/" class="mx-3"><i class="bi bi-tiktok"></i></a>
      <a href="/" class="mx-3"><i class="bi bi-facebook"></i></a>
    </div>


      <footer class="mt-5 text-white-50">
        <p>&copy; 2025 <%= username %></p>
      </footer>
      
    </div>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
  </body>
</html>